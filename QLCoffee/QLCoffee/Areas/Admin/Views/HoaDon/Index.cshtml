@using PagedList
@using PagedList.Mvc
@model PagedList.IPagedList<QLCoffee.Models.HOADON>

@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}

<h2 class="text-center my-4">QUẢN LÝ HÓA ĐƠN</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="searchString" class="form-control" placeholder="Tìm kiếm..." />
        <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    </div>

</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>
                Mã HĐ
            </th>
            <th>
                Khách hàng
            </th>
            <th>
                SĐT
            </th>
            <th>
                Địa Chỉ
            </th>
            <th>
                Tổng tiền
            </th>
            <th>
                Trạng thái
            </th>
            <th>Thao tác</th>
            <th>
                Ngày đặt
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>


        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.MaHD)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HoTenKH)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.SDT)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.GhiChu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TongGiaTriHD)
                </td>
                <td>
                    <select class="form-control status-dropdown" data-id="@item.MaHD" data-initial="@item.TrangThaiDH"
                            @(item.TrangThaiDH == "Đã giao" || item.TrangThaiDH == "Đã hủy" ? "disabled" : "")>
                        <option value="Đang xử lý" @(item.TrangThaiDH == "Đang xử lý" ? "selected" : "")>Đang xử lý</option>
                        <option value="Đã duyệt" @(item.TrangThaiDH == "Đã duyệt" ? "selected" : "")>Đã duyệt</option>
                        <option value="Đang giao" @(item.TrangThaiDH == "Đang giao" ? "selected" : "")>Đang giao</option>
                        <option value="Đã giao" @(item.TrangThaiDH == "Đã giao" ? "selected" : "")>Đã giao</option>
                        <option value="Đã hủy" @(item.TrangThaiDH == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                    </select>
                </td>
                <td>
                    <span class="text-success status-message" data-id="@item.MaHD"></span>
                </td>
                <td>
                    @item.NgayTD.ToString("dd/MM/yyyy")
                </td>
                <td class="text-center">
                    <div class="d-flex justify-content-center">
                        <a href="@Url.Action("Details", new { id = item.MaHD })" class="btn btn-sm btn-primary">
                            <i class="fas fa-eye"></i>
                        </a>
                    </div>
                </td>

            </tr>
        }
    </tbody>
</table>

<div class="d-flex justify-content-center">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { searchString = Request.QueryString["searchString"], page }),
        new PagedListRenderOptions
        {
            Display = PagedListDisplayMode.IfNeeded,
            UlElementClasses = new[] { "pagination", "pagination-sm" }, // Nhỏ gọn
            LiElementClasses = new[] { "page-item" }

        })
</div>

<script>
   $(document).ready(function () {
    // Thêm class Bootstrap cho phân trang
    $(".pagination li a").addClass("page-link");

    $(".status-dropdown").change(function () {
        var dropdown = $(this);
        var maHD = dropdown.data("id");
        var trangThaiMoi = dropdown.val();
        var trangThaiCu = dropdown.data("initial") || dropdown.find(":selected").val(); // Lưu trạng thái ban đầu
        var message = $(".status-message[data-id='" + maHD + "']");

        $.ajax({
            url: '@Url.Action("UpdateStatus","HoaDon", new { area = "Admin" })',
            type: "POST",
            data: { id: maHD, status: trangThaiMoi },
            success: function (response) {
                if (response.success) {
                    message.text("✔ Cập nhật thành công!").css({ "color": "green", "font-weight": "bold" }).fadeIn().delay(2000).fadeOut();
                    dropdown.data("initial", trangThaiMoi); // Lưu trạng thái mới để khôi phục nếu cần

                    // Thêm thông báo toast khi duyệt đơn hoặc hủy đơn
                    if (trangThaiMoi === "Đã duyệt") {
                        showToast(" Đơn hàng đã được duyệt!", "success");
                    } else if (trangThaiMoi === "Đã hủy") {
                        showToast(" Đơn hàng đã bị hủy!", "warning");
                    }

                    if (trangThaiMoi === "Đã giao" || trangThaiMoi === "Đã hủy") {
                        dropdown.prop("disabled", true); // Vô hiệu hóa nếu trạng thái không thể chỉnh sửa
                    }
                } else {
                    message.text(" " + response.message).css("color", "red").fadeIn().delay(2000).fadeOut();
                    dropdown.val(trangThaiCu); // Khôi phục giá trị ban đầu
                }
            },
            error: function () {
                message.text(" Lỗi kết nối! Vui lòng thử lại.").css("color", "red").fadeIn().delay(2000).fadeOut();
                dropdown.val(trangThaiCu); // Khôi phục giá trị ban đầu khi có lỗi
            }
        });
    });
       // Hàm hiển thị thông báo Toast
       function showToast(message, type) {
           var bgColor = type === "success" ? "bg-success" : "bg-warning";
           var toastHtml = `
            <div class="toast align-items-center text-white ${bgColor} border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="d-flex">
                    <div class="toast-body">
                        ${message}
                    </div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                </div>
            </div>`;

           var toastContainer = $("#toast-container");
           if (toastContainer.length === 0) {
               $("body").append('<div id="toast-container" class="position-fixed top-0 end-0 p-3" style="z-index: 1050;"></div>');
           }
           $("#toast-container").append(toastHtml);

           // Tự động ẩn Toast sau 3 giây
           setTimeout(function () {
               $("#toast-container .toast").first().remove();
           }, 3000);
       }
});



</script>
